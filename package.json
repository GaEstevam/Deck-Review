{
  "name": "deck-review",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "App de análise de deck de Pokémon TCG: partidas, versões, meta, confrontos e coleção de cartas.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev:emulador": "vite --mode emulador",
    "emuladores": "firebase emulators:start --project demo-deck-review",
    "test:regras": "firebase emulators:exec --only firestore --project demo-deck-review \"vitest run --config vitest.rules.config.ts\"",
    "deploy:regras": "firebase deploy --only firestore:rules"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "firebase": "^13.4.0",
    "firebase-tools": "^15.37.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
